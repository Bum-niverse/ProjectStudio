{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ProjectStudio",
  "version": "0.2.0",
  "identifier": "com.bumniverse.projectstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProjectStudio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:projectstudio.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "로컬 우선 제품 기획 및 개발 추적 도구",
    "longDescription": "아이디어를 PRD, 기능명세, 유저플로우와 와이어프레임으로 발전시키고 로컬에서 내보내는 개인용 데스크톱 프로그램입니다.",
    "copyright": "Copyright © 2026 Bum-niverse",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
